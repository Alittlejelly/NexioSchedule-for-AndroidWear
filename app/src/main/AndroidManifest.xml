<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        watch 特性声明为「非必须」：小米手表 5（国行 HyperOS）基于 Android 但未按
        Wear OS 规范声明该特性，声明为 required 会被部分安装入口直接拒绝。
        本应用本就是手表界面，不需要靠该标记限制分发。
    -->
    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="false" />

    <!-- 蓝牙接收课表：手表作为 BLE 外设广播，手机连上来推送整表 -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 在线更新：从 GitHub / Gitee 拉取 update.json 与 APK -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".CrashApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_app"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_app"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nexio">

        <!-- 独立运行：不依赖手机端 App 即可启动 -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- 在线更新：向系统安装器共享下载好的 APK -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Nexio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
